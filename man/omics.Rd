\subsection{\code{omics$distance()}}{
  Compute a distance metric from \code{countData}
  \subsection{Usage}{
    \if{html}{\out{<div class="r">}}
    \preformatted{omics$distance(
  metric,
  weighted = TRUE,
  threads = 1,
  normalize = TRUE,
  base = exp(1)
)}
    \if{html}{\out{</div>}}
  }
  \subsection{Arguments}{
    \if{html}{\out{<div class="arguments">}}
    \describe{
      \item{\code{metric}}{A dissimilarity metric to be applied on the \code{countData},
options: \describe{
\item{\code{"bray"}}{\link{bray}}
\item{\code{"jaccard"}}{\link{jaccard}}
\item{\code{"cosine"}}{\link{cosine}}
\item{\code{"manhattan"}}{\link{manhattan}}
\item{\code{"euclidean"}}{\link{euclidean}}
\item{\code{"jsd"}}{\link{jsd}}
\item{\code{"canberra"}}{\link{canberra}}
\item{\code{"unifrac"}}{\link{unifrac}}
\item{\code{"aitchison"}}{
The \code{"aitchison"} metric uses the \code{$scale(method = "clr")} without any pseudocounts, see \href{#method-scale}{\code{scale()}},
followed by euclidean dissimilarity computation.

Ref: Aitchison, J. (1986) The Statistical Analysis of Compositional Data. Chapman and Hall, London, 416 p.
}
}}
      \item{\code{weighted}}{A boolean value, to use abundances (\code{weighted = TRUE}) or absence/presence (\code{weighted=FALSE}) (default: \code{TRUE}).}
      \item{\code{threads}}{A wholenumber, indicating the number of threads to use (default: \code{1}).}
      \item{\code{normalize}}{A boolean value, whether to normalize weighted UniFrac distances to be between 0 and 1. Unweighted UniFrac is always normalized (default: \code{TRUE}).}
      \item{\code{base}}{Input for \link[base]{log} to use natural logarithmic scale, log2, log10 or other (default: \code{exp(1)}).}
    }
