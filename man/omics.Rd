counts <- data.frame(S1 = c(2,3,0), S2 = c(2,"",1), S3 = c(2,1,NA), proteins = c("ZEB1", "ZEB2", "MAPK"))

obj <- omics$new(
 metaData = metadata,
 countData = counts
)

